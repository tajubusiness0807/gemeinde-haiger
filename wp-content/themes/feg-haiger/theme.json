{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "color": "#0063ae", "name": "FeG-Blau" },
				{ "slug": "primary-dark", "color": "#00466e", "name": "FeG-Blau dunkel" },
				{ "slug": "banner-green", "color": "#1e896b", "name": "Banner-Grün" },
				{ "slug": "accent-red", "color": "#cc0000", "name": "Hinweis-Rot" },
				{ "slug": "kontrast", "color": "#444444", "name": "Text" },
				{ "slug": "muted", "color": "#666666", "name": "Text hell" },
				{ "slug": "border", "color": "#dddddd", "name": "Rahmen" },
				{ "slug": "light", "color": "#f3f3f3", "name": "Hellgrau (Seitenleiste)" },
				{ "slug": "footer", "color": "#f7f7f7", "name": "Hellgrau (Fußbereich)" },
				{ "slug": "white", "color": "#ffffff", "name": "Weiß" },
				{ "slug": "kal-gottesdienst", "color": "#4986e7", "name": "Kalender: Gottesdienste" },
				{ "slug": "kal-kinder", "color": "#42d692", "name": "Kalender: Kinder & Jugend" },
				{ "slug": "kal-senioren", "color": "#9a9cff", "name": "Kalender: Senioren" },
				{ "slug": "kal-bibel", "color": "#cd74e6", "name": "Kalender: Treffpunkt Bibel" }
			]
		},
		"layout": {
			"contentSize": "950px",
			"wideSize": "1140px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "XS" },
				{ "slug": "20", "size": "1rem", "name": "S" },
				{ "slug": "30", "size": "1.5rem", "name": "M" },
				{ "slug": "40", "size": "2.25rem", "name": "L" },
				{ "slug": "50", "size": "3.5rem", "name": "XL" },
				{ "slug": "60", "size": "5rem", "name": "XXL" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Systemschrift (Sans)",
					"fontFamily": "Roboto, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serifenschrift",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Klein", "fluid": false },
				{ "slug": "medium", "size": "1.0625rem", "name": "Normal", "fluid": false },
				{ "slug": "large", "size": "1.375rem", "name": "Groß", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "size": "1.875rem", "name": "Sehr groß", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "size": "2.75rem", "name": "Riesig", "fluid": { "min": "1.9rem", "max": "2.75rem" } }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|white",
			"text": "var:preset|color|kontrast"
		},
		"spacing": {
			"blockGap": "1.1rem",
			"padding": {
				"left": "16px",
				"right": "16px"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var:preset|color|primary-dark" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "fontWeight": "400", "lineHeight": "1.25" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "700" } },
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"border": { "radius": "3px" },
				"spacing": {
					"padding": { "top": "6px", "bottom": "6px", "left": "14px", "right": "14px" }
				},
				"typography": { "fontSize": "var:preset|font-size|small" },
				":hover": {
					"color": { "background": "var:preset|color|primary-dark" }
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|border", "width": "5px", "style": "solid" }
				},
				"spacing": {
					"padding": { "left": "1.25rem" }
				},
				"typography": { "fontStyle": "italic" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			},
			"core/navigation": {
				"typography": { "fontSize": "1rem" }
			},
			"core/post-title": {
				"typography": { "fontSize": "var:preset|font-size|x-large" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kopfbereich", "area": "header" },
		{ "name": "footer", "title": "Fußbereich", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-mit-titel", "title": "Seite mit automatischem Titel", "postTypes": [ "page" ] },
		{ "name": "page-volle-breite", "title": "Seite ohne Rahmen (volle Breite)", "postTypes": [ "page" ] }
	]
}
